    "마이너 조성의 해결. m7♭5에서 시작한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The minor-key resolution, starting from m7♭5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイナーキーの解決。m7♭5から始まる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小调的解决，从 m7♭5 开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小調的解決，從 m7♭5 開始。"
          }
        }
      }
    },
