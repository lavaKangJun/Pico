    "반음씩 내려오는 플라멩코풍 마이너 진행.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A flamenco-flavored minor line that steps down by half steps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半音ずつ下がるフラメンコ風のマイナー進行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半音下行的弗拉门戈风格小调进行。"
