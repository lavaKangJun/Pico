    "마이너로 시작해 밝게 풀리는, 시티팝에서 자주 들리는 흐름.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts minor and opens up bright — a city pop favorite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイナーで始まり明るく開ける、シティポップでよく聴く流れ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从小调开始、明亮展开，City Pop 中常听到的走向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從小調開始、明亮展開，City Pop 中常聽到的走向。"
          }
        }
      }
    },
