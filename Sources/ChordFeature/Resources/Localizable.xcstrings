    "루트를 고르면 그 음으로 쌓은 코드를 볼 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a root to see the chords built on it."
